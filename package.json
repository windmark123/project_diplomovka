{
  "name": "stvrty-pilier",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Štvrtý pilier – nástroj na návrh individuálneho investičného portfólia ako doplnku k dôchodkovému zabezpečeniu v SR (diplomová práca)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:single": "tsc -b && SINGLE_FILE=1 vite build",
    "audit:contrast": "node scripts/audit-contrast.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
